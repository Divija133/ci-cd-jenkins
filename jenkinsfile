pipeline {
    agent any

    environment {
        IMAGE_TAG = "${BUILD_NUMBER}"
    }

    stages {

        stage('Checkout') {
            steps {
                git credentialsId: 'github-token',
                    url: 'https://github.com/Divija133/ci-cd-jenkins',
                    branch: 'main'
            }
        }

        stage('Build Docker') {
            steps {
                script {
                    sh '''
                    echo 'Build Docker Image'
                    docker build -t divija13/cicd-e2e:${BUILD_NUMBER} .
                    '''
                }
            }
        }

        stage('Push the artifacts') {
            steps {
                script {
                    withCredentials([usernamePassword(credentialsId: 'dockerhub-creds', usernameVariable: 'DOCKER_USER', passwordVariable: 'DOCKER_PASS')]) {
                        sh '''
                        echo 'Login and Push to Docker Hub'
                        docker login -u $DOCKER_USER -p $DOCKER_PASS
                        docker push divija13/cicd-e2e:${BUILD_NUMBER}
                        '''
                    }
                }
            }
        }
           
        stage('Checkout K8S manifest SCM') {
            steps {
                git credentialsId: 'github-creds',
                    url: 'https://github.com/Divija133/cicd-demo-manifests-repo.git',
                    branch: 'main'
            }
        }

        stage('Update K8S manifest & push to Repo') {
            steps {
                script {
                    withCredentials([usernamePassword(credentialsId: 'github-creds', usernameVariable: 'GIT_USERNAME', passwordVariable: 'GIT_PASSWORD')]) {
                        sh '''
                        echo 'Update K8S manifest'
                        sed -i "s|image: .*|image: divija13/cicd-e2e:${BUILD_NUMBER}|g" k8s/deployment.yml
			git config user.email "ci-bot@divija133.com"
            		git config user.name "Jenkins CI Bot"
                        git add k8s/deployment.yml
                        git commit -m 'Updated deploy.yaml | Jenkins Pipeline'
                        git push https://${GIT_USERNAME}:${GIT_PASSWORD}@github.com/Divija133/cicd-demo-manifests-repo.git HEAD:main
                        '''
                    }
                }
            }
        }
    }
}

